{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "version":"1.0.0",
  "name":"mind-reply-estate-autonomy",
  "mode":"evidence-first",
  "principles":["no-blind-merge","no-blind-delete","no-unverified-production","secrets-never-in-git","destructive-actions-require-owner-approval","every-mutation-requires-receipt","unknown-is-not-healthy"],
  "territories":[{"id":"personal","owner":"angellllkr-eng","role":"development-estate"},{"id":"commercial","owner":"Mind-Reply","role":"commercial-product-ecosystem"},{"id":"intelligence","owner":"A11-K","role":"command-intelligence-ecosystem"}],
  "states":["PLANNED","IMPLEMENTED","BUILT","PREVIEW","VERIFIED","PRODUCTION","DEGRADED","DOWN","BLOCKED","STALE","UNKNOWN","RECOVERING"],
  "agents":[
    {"id":"estate-cartographer","mission":"Enumerate all repositories, metadata, workflows, stacks, deployments and boundaries across all three territories.","schedule":"0 */6 * * *","permissions":"read-only","outputs":["estate-inventory","repository-graph","estate-report"]},
    {"id":"dependency-graph","mission":"Build only evidence-backed DEPENDS_ON, CALLS, DEPLOYS, OBSERVES, CONTROLS, EMBEDS, REPLACES, DUPLICATES, SUPERSEDES or UNKNOWN relationships.","schedule":"17 */6 * * *","depends_on":["estate-cartographer"],"permissions":"read-only","outputs":["repository-graph"]},
    {"id":"security-sentinel","mission":"Scan tracked trees, history where available, Actions and configuration for secrets, unsafe permissions and sensitive artifacts without exposing values.","schedule":"*/30 * * * *","trigger":["push","pull_request","schedule"],"permissions":"read-only","outputs":["security-findings","security-receipt"],"blocks_on":["credential-exposure","customer-data-exposure","unsafe-production-mutation"]},
    {"id":"canonicality-architect","mission":"Compare duplicate-looking repositories by implementation, activity, deployment, domains, security, dependencies and unique assets; recommend canonical, migrate, consolidate, supersede or archive.","schedule":"0 2 * * *","depends_on":["estate-cartographer","dependency-graph","security-sentinel"],"permissions":"proposal-only","never":["delete","transfer"]},
    {"id":"governance-guardian","mission":"Audit CODEOWNERS, branch protection, required checks, environments, Actions permissions, security policy, PR templates and organization standards.","schedule":"0 3 * * 1","permissions":"read-only","outputs":["governance-report"]},
    {"id":"pr-triage","mission":"Classify every open PR KEEP, FIX, REBASE, MERGE, SPLIT, SUPERSEDE or CLOSE using architecture, CI and security evidence.","schedule":"0 */4 * * *","depends_on":["canonicality-architect","security-sentinel"],"permissions":"proposal-only","approval_required":["merge","close"]},
    {"id":"issue-triage","mission":"Classify important issues P0-P3, DUPLICATE, BLOCKED or ARCHIVE using customer, revenue, security, reliability and effort evidence.","schedule":"0 5 * * *","permissions":"label-and-report-only"},
    {"id":"production-reality-gate","mission":"Verify DNS, TLS, HTTP, redirects, canonical URL, health, critical routes, auth boundary, API response, deployment SHA and critical journey.","schedule":"*/15 * * * *","trigger":["deployment","workflow_dispatch","schedule"],"permissions":"probe-only","outputs":["reality-receipt"],"failure_state":"BLOCKED_OR_DEGRADED"},
    {"id":"release-guardian","mission":"Enforce CHANGE→PR→analysis→typecheck→tests→build→security→Reality Gate→preview→approval→production→post-probe→receipt.","trigger":["pull_request","workflow_dispatch"],"permissions":"promotion-policy","approval_required":["production-deploy","rollback"]},
    {"id":"mindreply-commercial","mission":"Trace visitor→value→CTA→contact/checkout→auth→core product→delivery and identify the first broken commercial link.","schedule":"0 */2 * * *","depends_on":["production-reality-gate"],"permissions":"probe-only","outputs":["commercial-journey"]},
    {"id":"a11k-command-guardian","mission":"Enforce INTENT→PLAN→PREVIEW→RISK→AUTHORIZATION→EXECUTION→VERIFICATION→RECEIPT→RETURN and prevent uncontrolled production mutation.","schedule":"*/10 * * * *","permissions":"bounded-low-risk","approval_required":["high","critical"]},
    {"id":"integration-sentinel","mission":"Map and health-check Supabase, Neon, Vercel, Cloudflare, Stripe, n8n, GitHub Actions, messaging and model/API dependencies.","schedule":"*/30 * * * *","permissions":"read-and-probe-only","outputs":["integration-map","dependency-health"]},
    {"id":"cost-performance","mission":"Measure build time, page/API latency, dependency latency, deployment duration and major cost centers before recommending optimization.","schedule":"0 6 * * 1","permissions":"read-only","outputs":["cost-performance"]},
    {"id":"recovery-operator","mission":"Execute only bounded reversible recovery; prepare rollback plans and receipts. Never change secrets, billing, DNS, permissions or delete repositories autonomously.","trigger":["alert","workflow_dispatch"],"permissions":"low-risk-only","approval_required":["production-rollback","secret-change","billing-change","dns-change","delete-repository"]},
    {"id":"evidence-recorder","mission":"Normalize important operations into timestamped attributable receipts without credentials or unnecessary PII.","trigger":["workflow_run","repository_dispatch"],"permissions":"append-only","outputs":["evidence-record"]}
  ],
  "automation_policy":{
    "safe_now":["repository discovery","file/workflow inspection","tests","static analysis","reports","receipts","non-destructive labels","documentation branches","production probes","bounded low-risk recovery"],
    "dependency_first":["merge consolidation PRs","extract unique assets","promote canonical root","enable production deployment automation"],
    "owner_approval":["production deployment outside protected policy","production rollback","secret rotation/change","billing changes","DNS changes","organization permission changes","repository transfer","repository deletion","permanent uncertain archive","making private operational code public"],
    "reject":["print secret values","blind delete","blind merge","claim production from repository existence","uncontrolled A11-K mutation","copy production customer data into public repositories"]
  },
  "priority_engine":{"weights":{"customer_value":0.2,"revenue_impact":0.2,"security_impact":0.2,"reliability_impact":0.15,"architectural_leverage":0.1,"effort_inverse":0.05,"risk_inverse":0.05,"reversibility":0.05},"hard_blocks":["P0_security","credential_exposure","customer_data_exposure","failed_critical_reality_gate"]},
  "global_schedules":{"estate_reconstruction":"0 1 * * *","security_scan":"*/30 * * * *","production_reality":"*/15 * * * *","dependency_health":"*/30 * * * *","daily_exec_report":"0 7 * * *","weekly_architecture_review":"0 8 * * 1"},
  "receipt":{"required":["id","operation","target","actor","started_at","completed_at","inputs_hash","result","artifacts","state","next_action"],"release":["release_id","repository","commit_sha","environment","timestamp","actor","checks","result","rollback_target"]},
  "success":["one verified commercial product","one verified A11-K command system","one verified release path","one verified commercial workflow","observable production state","recoverable critical failures","no unresolved P0 credential exposure"]
}
